# Salin file ini menjadi .env lalu isi nilainya

# ── Database ─────────────────────────────────────────────────
# Untuk development lokal (tanpa Docker):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hikari_hris"

# Untuk Docker (otomatis diisi oleh docker-compose):
DATABASE_URL="postgresql://hikari:hikari_secret@db:5432/hikari_hris"

# Password database (digunakan docker-compose)
DB_PASSWORD=hikari_secret

# Port Nginx (default: 80 → akses via http://hris.hikari.local)
NGINX_PORT=8080
